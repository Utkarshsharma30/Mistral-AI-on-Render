# Environment Mode: 'proxy', 'remote_ollama', or 'llama_cpp'
ENGINE_MODE=proxy

# Official Mistral API Key (from console.mistral.ai)
MISTRAL_API_KEY=your_mistral_api_key_here

# Mistral Model Name (e.g., mistral-small-latest, open-mistral-7b, mistral-large-latest)
MISTRAL_MODEL=mistral-small-latest

# Optional: Ollama Base URL (if using remote_ollama mode)
OLLAMA_BASE_URL=https://your-ngrok-subdomain.ngrok-free.app

# Server Port
PORT=8000
